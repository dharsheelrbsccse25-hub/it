9- Review & Merge (done by owner)
# 1. Ensure you are on main and up to date
git checkout main
git pull origin main

# 2. Create a temporary branch and make a change
git checkout -b test-conflict
echo "Change from branch" >> README.md
git commit -am "Edit readme on branch"

# 3. Switch back to main and make a conflicting change on the exact same line
git checkout main
echo "Change from main" >> README.md
git commit -am "Edit readme on main"

# 4. Try to merge the branch into main (This triggers the conflict)
git merge test-conflict
